{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci && npm run build && python scripts/assemble_render_model.py",
  "regions": ["bom1"],
  "functions": { "app.py": { "maxDuration": 120, "excludeFiles": "{.git,.github,.venv*,**/node_modules,node_modules,api,ml,data,artifacts,output,firmware,apps/{mobile,edge_api/tests,web/src},scripts,docs,supabase,deployment/{model-parts,private,runtime,logs,releases/{automatic-recapture-20260912,automatic-three-class-20260912,camera-multiangle-trial-20261019,camera-retrained-trial-20261019,camera-trial-20261018,source-labels-20260912}}}/**" } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), serial=(self)" },
    { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
  ] }]
}
