BALUT_ENV=development
BALUT_DATABASE_PATH=./data/balut.db
BALUT_EVIDENCE_PATH=./data/evidence
BALUT_LOCAL_ADMIN_TOKEN=replace-with-a-long-random-local-token
BALUT_DEVICE_SHARED_SECRET=replace-with-a-per-device-secret
BALUT_ALLOW_SIMULATOR=true
BALUT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE=http://127.0.0.1:8000/api/v1
VITE_LOCAL_TOKEN=replace-with-the-paired-local-operator-token
# Optional shared storage; backend only. Never use a VITE_ prefix or commit real values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Vercel: set only SUPABASE_URL, SUPABASE_SECRET_KEY and BALUT_DEVICE_SHARED_SECRET.
# Keep system variables enabled; app.py uses VERCEL_PROJECT_PRODUCTION_URL.
# Do not copy the VITE_* development settings above into the cloud deployment.
